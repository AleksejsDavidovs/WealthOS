# WealthOS banking backend — configuration template.
# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env` or the private key.
# Placeholders only: nothing in this file is a real credential.

# --- Enable Banking application (Control Panel → API applications) ---
# Only "sandbox" is allowed until production is explicitly enabled below.
EB_ENVIRONMENT=sandbox
# The application ID (UUID) shown in the Control Panel; used as the JWT "kid".
EB_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# Absolute path to the application's RSA private key (PEM). Keep it OUTSIDE the repository,
# readable only by you (chmod 600). The server refuses to start if group/others can read it.
EB_PRIVATE_KEY_PATH=/Users/YOUR_USER/.wealthos/keys/enablebanking-sandbox.pem
EB_API_BASE=https://api.enablebanking.com
# Must be whitelisted exactly in the Enable Banking application's redirect URLs.
EB_REDIRECT_URL=http://localhost:8787/v1/callback
# Bank allow-list. Verify the exact ASPSP name with: python -m app.tools list-aspsps --country LV
EB_ASPSP_NAME=Swedbank
EB_ASPSP_COUNTRY=LV
# Requested consent length in days (the bank may allow less; lower it if authorization fails).
EB_CONSENT_DAYS=90

# --- WealthOS app client (what you enter in WealthOS → Settings → Bank Connections → Banking Server) ---
# Generate with: python -m app.tools new-client
WOS_CLIENT_ID=wealthos-ios
WOS_CLIENT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_FROM_new-client
# 32-byte base64 key encrypting Enable Banking session ids at rest. Generate with: python -m app.tools new-data-key
WOS_DATA_KEY=REPLACE_WITH_BASE64_KEY_FROM_new-data-key

# --- Server ---
WOS_DB_PATH=./data/wealthos-banking.sqlite3
WOS_APP_CALLBACK=wealthos://bank-callback
# Host headers accepted (TrustedHost). Add your HTTPS hostname for production.
WOS_ALLOWED_HOSTS=localhost,127.0.0.1
# Production requires an explicit, deliberate opt-in. Leave empty.
WOS_ALLOW_PRODUCTION=
