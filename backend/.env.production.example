# WealthOS banking backend — PRODUCTION configuration template (real bank data).
# Copy to `.env.production` (git-ignored, chmod 600). Placeholders only: nothing here is a real credential.
# Start with: WOS_ENV_FILE=.env.production uvicorn app.main:app --host 127.0.0.1 --port 8788 --no-access-log
# Every value below is SEPARATE from the sandbox `.env`: own application, key, client secret, data key, database.

EB_ENVIRONMENT=production
# Deliberate opt-in. The server refuses production without exactly this value.
WOS_ALLOW_PRODUCTION=I_UNDERSTAND_THIS_ACCESSES_REAL_BANK_DATA

# Production application from the Enable Banking Control Panel (not the sandbox one).
EB_APPLICATION_ID=00000000-0000-0000-0000-000000000000
EB_PRIVATE_KEY_PATH=/Users/YOUR_USER/.wealthos/secrets/production/APPLICATION_ID.pem
EB_API_BASE=https://api.enablebanking.com
# HTTPS URL of this server as reachable from your iPhone; whitelist exactly this in the production application.
EB_REDIRECT_URL=https://YOUR-MAC.YOUR-TAILNET.ts.net/v1/callback
EB_ASPSP_NAME=Swedbank
EB_ASPSP_COUNTRY=LV
EB_CONSENT_DAYS=90

# New values — never reuse the sandbox ones. Generate with python -m app.tools new-client / new-data-key.
WOS_CLIENT_ID=wealthos-iphone
WOS_CLIENT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_FROM_new-client
WOS_DATA_KEY=REPLACE_WITH_BASE64_KEY_FROM_new-data-key

# Separate database; the server labels it "production" and refuses a sandbox database (and vice versa).
WOS_DB_PATH=./data/production/wealthos-banking.sqlite3
WOS_APP_CALLBACK=wealthos://bank-callback
# Must include the EB_REDIRECT_URL host (checked at startup). No localhost: production is reached via HTTPS only.
WOS_ALLOWED_HOSTS=YOUR-MAC.YOUR-TAILNET.ts.net
